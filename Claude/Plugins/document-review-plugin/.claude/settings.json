{
  "permissions": {
    "allow": [
      "Read(*)",
      "Bash(echo:*)"
    ],
    "deny": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[document-review] Review task completed at $(date)\""
          }
        ]
      }
    ]
  }
}
